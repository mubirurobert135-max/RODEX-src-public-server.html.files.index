{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and metadata",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "User conversation thread",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "activeMode": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Message within a conversation",
      "type": "object",
      "properties": {
        "sender": { "type": "string", "maxLength": 20 },
        "text": { "type": "string", "maxLength": 10000 },
        "timestamp": { "type": "string" },
        "toolCalls": { "type": "string", "maxLength": 5000 }
      },
      "required": ["sender", "text", "timestamp"]
    },
    "MemoryItem": {
      "title": "MemoryItem",
      "description": "Long-term user memory entry",
      "type": "object",
      "properties": {
        "category": { "type": "string", "maxLength": 50 },
        "key": { "type": "string", "maxLength": 100 },
        "value": { "type": "string", "maxLength": 2000 },
        "confidence": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["key", "value", "createdAt"]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Scheduled task or reminder",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "datetime": { "type": "string" },
        "status": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "maxLength": 20 },
        "recurrence": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "datetime", "status", "createdAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences and system configuration",
      "type": "object",
      "properties": {
        "theme": { "type": "string", "maxLength": 30 },
        "voiceVolume": { "type": "number" },
        "autoSpeak": { "type": "boolean" },
        "autoListen": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "VoiceProfile": {
      "title": "VoiceProfile",
      "description": "User-specific voice synthesis profile",
      "type": "object",
      "properties": {
        "voiceId": { "type": "string", "maxLength": 100 },
        "pitch": { "type": "number" },
        "rate": { "type": "number" },
        "accent": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string" }
      }
    },
    "Integration": {
      "title": "Integration",
      "description": "Connected third-party service integration",
      "type": "object",
      "properties": {
        "provider": { "type": "string", "maxLength": 50 },
        "connected": { "type": "boolean" },
        "email": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string" }
      },
      "required": ["provider", "connected", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Multi-step operational agent task or goal",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "goal": { "type": "string", "maxLength": 1000 },
        "state": { "type": "string", "maxLength": 50 },
        "currentStepIndex": { "type": "number" },
        "requiresConfirmation": { "type": "boolean" },
        "confirmationPrompt": { "type": "string", "maxLength": 500 },
        "resultSummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "state", "createdAt"]
    },
    "TaskStep": {
      "title": "TaskStep",
      "description": "Sub-step within a multi-step agent task",
      "type": "object",
      "properties": {
        "stepNumber": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 30 },
        "toolName": { "type": "string", "maxLength": 100 },
        "error": { "type": "string", "maxLength": 500 }
      },
      "required": ["stepNumber", "title", "status"]
    },
    "TaskEvent": {
      "title": "TaskEvent",
      "description": "Lifecycle event or state change audit for a task",
      "type": "object",
      "properties": {
        "taskId": { "type": "string", "maxLength": 100 },
        "eventType": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string" }
      },
      "required": ["taskId", "eventType", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User conversation thread"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "User message within conversation"
    },
    "/users/{userId}/memory/{memoryId}": {
      "schema": "MemoryItem",
      "description": "User long-term memory entry"
    },
    "/users/{userId}/schedules/{scheduleId}": {
      "schema": "ScheduleItem",
      "description": "User scheduled item"
    },
    "/users/{userId}/settings/{settingDoc}": {
      "schema": "UserSettings",
      "description": "User settings document"
    },
    "/users/{userId}/voice/{voiceDoc}": {
      "schema": "VoiceProfile",
      "description": "User voice profile settings"
    },
    "/users/{userId}/integrations/{integrationId}": {
      "schema": "Integration",
      "description": "User connected integration"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User agent tasks and state"
    },
    "/users/{userId}/tasks/{taskId}/steps/{stepId}": {
      "schema": "TaskStep",
      "description": "Steps belonging to a specific agent task"
    },
    "/users/{userId}/tasks/{taskId}/events/{eventId}": {
      "schema": "TaskEvent",
      "description": "Lifecycle event audit log for a task"
    }
  }
}

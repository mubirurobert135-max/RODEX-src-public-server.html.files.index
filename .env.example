# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SPOTIFY_CLIENT_ID: Client ID from your Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
# Required for RODEX to connect and control Spotify playback on your PC.
SPOTIFY_CLIENT_ID=

# SPOTIFY_CLIENT_SECRET: Client Secret from your Spotify Developer Dashboard
# Required for token exchange to control Spotify on your PC.
SPOTIFY_CLIENT_SECRET=

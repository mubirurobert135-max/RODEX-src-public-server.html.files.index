{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:watch": "tsx scripts/doctorWatch.ts",
    "test:doctor": "tsx scripts/testDoctor.ts",
    "test:recovery": "tsx scripts/testRecovery.ts",
    "test:realtime": "tsx scripts/testRealTimeEngine.ts",
    "test:action": "tsx scripts/testActionEngine.ts",
    "test:gmail": "tsx scripts/testGmailIntegration.ts",
    "test:multiuser": "tsx scripts/testMultiUser.ts",
    "test:orb": "tsx scripts/testOrbWake.ts",
    "test:firebase": "tsx scripts/testFirebaseIntegration.ts",
    "test:agent": "tsx scripts/testAgentTaskEngine.ts",
    "lint": "tsc --noEmit",
    "test:grounding": "tsx scripts/testGrounding.ts",
    "test:voice": "tsx scripts/testVoiceResponseReliability.ts",
    "test:chat-ui": "tsx scripts/testChatNavigation.ts",
    "test:human-presence": "tsx scripts/testHumanPresence.ts",
    "test:auth": "tsx scripts/testAuthGuards.ts",
    "test:booking": "tsx scripts/testBookingIntegrity.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
